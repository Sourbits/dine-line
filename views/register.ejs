<%- include('partials/header', { title: 'Sign up' }) %>

  <main>
    <section class="form-card">
      <h1>Create your account</h1>

      <% if (errors.length > 0) { %>
        <div class="message error" role="alert">
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="POST">
        <label for="email">Email</label>
        <input aria-describedby="emailError" type="email" id="email" name="email" value="<%= email %>" maxlength="254" required>
        <p class="field-error" id="emailError" aria-live="polite"></p>

        <label for="password">Password (at least 10 characters)</label>
        <input aria-describedby="passwordError" type="password" id="password" name="password" minlength="10" maxlength="72" required>
        <p class="field-error" id="passwordError" aria-live="polite"></p>

        <label for="confirmPassword">Confirm password</label>
        <input aria-describedby="confirmPasswordError" type="password" id="confirmPassword" name="confirmPassword" required>
        <p class="field-error" id="confirmPasswordError" aria-live="polite"></p>

        <button type="submit" class="button">Sign up</button>
      </form>

      <p>Already have an account? <a href="/login">Log in</a></p>
    </section>
  </main>

  <script src="/js/register.js"></script>

<%- include('partials/footer') %>
