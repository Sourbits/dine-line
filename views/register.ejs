<%- include('partials/header', { title: 'Sign up' }) %>

  <main>
    <section class="form-card">
      <h1>Create your account</h1>

      <% if (success) { %>
        <p class="message success">Your account was created. Log in will be available soon.</p>
      <% } %>

      <% if (errors.length > 0) { %>
        <div class="message error" role="alert">
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="POST">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= email %>" maxlength="254" required>

        <label for="password">Password (at least 8 characters)</label>
        <input type="password" id="password" name="password" minlength="8" maxlength="72" required>

        <label for="confirmPassword">Confirm password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required>

        <button type="submit" class="button">Sign up</button>
      </form>
    </section>
  </main>

<%- include('partials/footer') %>
